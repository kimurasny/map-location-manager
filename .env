# 地図データ生成の設定
#
# ここを変更するだけで対象地域を切り替えられる（例: 関東 → 日本全体）。
#   関東:     MAP_NAME=kanto      PBF_URL=.../asia/japan/kanto-latest.osm.pbf   OUTPUT_MBTILES=kanto.mbtiles
#   日本全体: MAP_NAME=japan      PBF_URL=.../asia/japan-latest.osm.pbf         OUTPUT_MBTILES=japan.mbtiles
#
# scripts/ 配下のスクリプトと docker-compose.yml がこの値を参照する。

# 地域を識別する名前（生成物のファイル名などに利用）
MAP_NAME=kanto

# Geofabrik の OpenStreetMap PBF ダウンロード URL
PBF_URL=https://download.geofabrik.de/asia/japan/kanto-latest.osm.pbf

# 生成する MBTiles ファイル名（data/ 配下に出力）
OUTPUT_MBTILES=kanto.mbtiles

# 生成するズームレベルの範囲（大きいほど詳細だが容量・生成時間が増大する）
MIN_ZOOM=0
MAX_ZOOM=14

# 利用する OpenMapTiles のバージョン（標準手順の再現性のため固定する）
OMT_VERSION=v3.16
